# Feature flags
EXPO_PUBLIC_DURING_SHIFT_V2=true

# Supabase Local — copy from `npx supabase status` after `npx supabase start`
# The standard local anon key is publicly documented in Supabase docs and
# identical in every fresh install. Run `npx supabase status` to get yours.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<supabase-local-anon-key>
