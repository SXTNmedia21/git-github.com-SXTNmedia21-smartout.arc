{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "tests/**/*.ts",
    "helpers/**/*.ts",
    "protocols/**/*.ts",
    "runners/**/*.ts",
    "generators/**/*.ts",
    "reporters/**/*.ts",
    "engine-world/**/*.ts",
    "playwright.config.ts",
    "global-setup.ts"
  ]
}
