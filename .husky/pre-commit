#!/bin/sh
# ============================================================
# PRE-COMMIT HOOK — Security Protocol Enforcement
# Source of truth: docs/protocols/SECURITY.md
# Enforces: LAW 3 (never commit secrets to Git)
# ============================================================

# 1. Run lint-staged (eslint + prettier on staged files)
npx lint-staged

# 2. Secret detection — scan staged diff for known key patterns
#
# Patterns derived from:
#   - Security Protocol §2.3 (Key Format): smo_sk_, smo_svc_
#   - Security Protocol §4.3 (Deployment Checklist): sk_live_, sk_test_
#   - env.ts Zod validation: whsec_, SG.
#   - JWT detection: eyJhbGciOi (base64 of {"alg":)
#
# Allowlisted file patterns (docs that reference key formats):
#   - docs/**/*.md, CLAUDE.md, *.md in docs/
#   - .husky/* (this hook itself contains detection patterns)
#   - infra/docker-compose.yml (env var mappings like DEV_API_KEY=${...})
#   - supabase/config.toml (schema config, no secrets)
#   - .env.template (op:// references, not real values)
#   - These legitimately show key format examples like smo_sk_live_k7HjQ9...
#
# This hook does NOT catch:
#   - Secrets in binary files (use .gitignore)
#   - Secrets already in history (use git-secrets or truffleHog for audit)

# Explicitly scan non-deleted staged changes only:
# A=Added, C=Copied, M=Modified, R=Renamed, T=Type changed
STAGED_DIFF=$(git diff --cached --diff-filter=ACMRT -- . \
  ':!docs/**/*.md' \
  ':!CLAUDE.md' \
  ':!*.md' \
  ':!.husky/*' \
  ':!scripts/quality/*' \
  ':!infra/docker-compose.yml' \
  ':!supabase/config.toml' \
  ':!.env.template' \
)

if [ -z "$STAGED_DIFF" ]; then
  exit 0
fi

# Smartout platform keys (Security Protocol §2.3)
if echo "$STAGED_DIFF" | grep -qE 'smo_sk_(live|test)_[A-Za-z0-9]{20,}'; then
  echo ""
  echo "ERROR: Smartout workspace API key detected in staged changes!"
  echo "  Pattern: smo_sk_(live|test)_*"
  echo "  Violation: Security Protocol LAW 3"
  echo "  Fix: Use environment variable or op:// reference"
  echo ""
  exit 1
fi

if echo "$STAGED_DIFF" | grep -qE 'smo_svc_(live|test)_[A-Za-z0-9]{20,}'; then
  echo ""
  echo "ERROR: Smartout service key detected in staged changes!"
  echo "  Pattern: smo_svc_(live|test)_*"
  echo "  Violation: Security Protocol LAW 3"
  echo "  Fix: Use environment variable or op:// reference"
  echo ""
  exit 1
fi

# Stripe secret keys (live + test)
if echo "$STAGED_DIFF" | grep -qE 'sk_(live|test)_[A-Za-z0-9]{20,}'; then
  echo ""
  echo "ERROR: Stripe secret key detected in staged changes!"
  echo "  Pattern: sk_(live|test)_*"
  echo "  Violation: Security Protocol LAW 3"
  echo "  Fix: Use STRIPE_SECRET_KEY env var"
  echo ""
  exit 1
fi

# Stripe webhook secrets
if echo "$STAGED_DIFF" | grep -qE 'whsec_[A-Za-z0-9]{20,}'; then
  echo ""
  echo "ERROR: Stripe webhook secret detected in staged changes!"
  echo "  Pattern: whsec_*"
  echo "  Violation: Security Protocol LAW 3"
  echo "  Fix: Use STRIPE_WEBHOOK_SECRET env var"
  echo ""
  exit 1
fi

# SendGrid keys
if echo "$STAGED_DIFF" | grep -qE 'SG\.[A-Za-z0-9_-]{20,}'; then
  echo ""
  echo "ERROR: SendGrid API key detected in staged changes!"
  echo "  Pattern: SG\\.[A-Za-z0-9_-]{20,}"
  echo "  Violation: Security Protocol LAW 3"
  echo "  Fix: Use SENDGRID_API_KEY env var"
  echo ""
  exit 1
fi

# JWT tokens (Supabase service role key or any raw JWT)
if echo "$STAGED_DIFF" | grep -qE 'eyJ[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}'; then
  echo ""
  echo "ERROR: JWT token detected in staged changes!"
  echo "  Pattern: eyJ*.*.* (JWT header.payload.signature)"
  echo "  Violation: Security Protocol LAW 3"
  echo "  This may be a Supabase service role key or auth token."
  echo "  Fix: Use environment variable — never inline JWTs"
  echo ""
  exit 1
fi

# Generic high-entropy secret assignment (catches password="...", secret="...", token="...")
# Only flags assignments with values longer than 20 chars (avoids false positives on short strings)
if echo "$STAGED_DIFF" | grep -qE "(password|secret|token|api_key|apiKey|API_KEY)[[:space:]]*[=:][[:space:]]*['\"][A-Za-z0-9+/=_-]{20,}['\"]"; then
  echo ""
  echo "WARNING: Possible hardcoded secret detected in staged changes!"
  echo "  Pattern: password/secret/token/api_key = \"<long_string>\""
  echo "  Violation: Security Protocol LAW 1 + LAW 3"
  echo "  Review with: git diff --cached"
  echo "  If this is a false positive, use: git commit --no-verify (document why)"
  echo ""
  exit 1
fi

# .env file content in non-.env files (catches copy-paste accidents)
if echo "$STAGED_DIFF" | grep -qE '^[+].*SUPABASE_SERVICE_ROLE_KEY=ey'; then
  echo ""
  echo "ERROR: Supabase service role key assignment detected!"
  echo "  Pattern: SUPABASE_SERVICE_ROLE_KEY=ey*"
  echo "  Violation: Security Protocol LAW 3"
  echo "  Service role key MUST be in .env.local (gitignored)"
  echo ""
  exit 1
fi

# ============================================================
# KNOWLEDGE SYSTEM HOOKS (ADR-0075 enforcement)
# ============================================================

# 3. ADR number collision check
# Prevents the 2026-04-07 incident where parallel branches created
# multiple ADRs with the same number (0049, 0058, 0059, 0071).
ADR_DUPES=$(ls docs/decisions/ 2>/dev/null | grep -E '^[0-9]{4}-' | grep -v '^0000-' | awk -F- '{print $1}' | sort | uniq -d)
if [ -n "$ADR_DUPES" ]; then
  echo ""
  echo "ERROR: Duplicate ADR numbers detected in docs/decisions/"
  echo "  Colliding numbers:"
  echo "$ADR_DUPES" | sed 's/^/    /'
  echo "  Violation: ADR-0075 — each ADR number must be unique"
  echo "  Resolve by renumbering the weaker-referenced ADR to the next gap."
  echo ""
  exit 1
fi

# 4. Learning number collision check (same rationale)
LEARNING_DUPES=$(ls docs/learnings/ 2>/dev/null | grep -E '^[0-9]{4}-' | grep -v '^0000-' | awk -F- '{print $1}' | sort | uniq -d)
if [ -n "$LEARNING_DUPES" ]; then
  echo ""
  echo "ERROR: Duplicate learning numbers detected in docs/learnings/"
  echo "  Colliding numbers:"
  echo "$LEARNING_DUPES" | sed 's/^/    /'
  echo "  Violation: ADR-0075 — each learning number must be unique"
  echo ""
  exit 1
fi

# 5. SESSION.md resurrection check
# Per ADR-0075, SESSION.md is deleted. Prevent it from being re-added.
if git diff --cached --name-status | grep -qE '^A\s+docs/SESSION\.md$'; then
  echo ""
  echo "ERROR: docs/SESSION.md is deprecated and must not be re-added"
  echo "  Per ADR-0075, session narrative lives in:"
  echo "    - ~/dev/second-brain-v2/ops/activity-log.md (audit)"
  echo "    - claude-mem via MCP (cross-session memory)"
  echo "    - ~/.claude/projects/<repo>/memory/ (in-flight context)"
  echo "  If you really need this, revisit the ADR first."
  echo ""
  exit 1
fi

# 6. DASHBOARD.md structure check
# Per ADR-0075, DASHBOARD.md is pure git state — no history sections.
if git diff --cached --name-only | grep -q '^docs/DASHBOARD\.md$'; then
  if grep -qE '^## (Session History|Recent Closures)$' docs/DASHBOARD.md; then
    echo ""
    echo "ERROR: docs/DASHBOARD.md contains forbidden history sections"
    echo "  Found: ## Session History or ## Recent Closures"
    echo "  Violation: ADR-0075 — DASHBOARD.md is pure git state only"
    echo "  History belongs in ~/dev/second-brain-v2/ops/activity-log.md"
    echo ""
    exit 1
  fi
fi

# 7. Branch guard — protect preview/main from direct commits
# Policy (Pontus, 2026-04-08): development is the working integration branch
# and accepts direct commits + direct push. The protected boundary starts at
# preview. preview accepts only fast-forward from development (enforced in
# pre-push). main accepts only PRs from preview (GitHub branch protection).
#
# Rationale: ADR-0075 v1.1 originally blocked development too, requiring all
# work through worktrees. Worktree discipline proved too heavy for small chore
# commits and bot-friendly hotfixes. The mechanical guard now sits where the
# real risk is — preview/main, which feed staging and prod.
#
# Allows merge commits (MERGE_HEAD present) on preview/main (e.g. FF merges).
current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
if [ "$current_branch" = "preview" ] || [ "$current_branch" = "main" ]; then
  if [ ! -f .git/MERGE_HEAD ]; then
    echo ""
    echo "ERROR: Direct commits to '$current_branch' are forbidden."
    echo ""
    echo "  Pipeline: development → preview → main"
    echo "    • development: direct commits and direct push allowed"
    echo "    • preview:     fast-forward from development only"
    echo "    • main:        pull request from preview only"
    echo ""
    echo "  Hotfixes: branch from main into hotfix/*, open PR back to main."
    echo ""
    exit 1
  fi
fi

# 8. ORIENTATION.md must reference ADR-0075
# Prevents accidental drift if someone edits ORIENTATION.md and removes the
# anchor to its source-of-authority ADR. Per Steward R3.3 in council retrospective.
if git diff --cached --name-only | grep -q '^docs/ORIENTATION\.md$'; then
  if ! grep -q '0075' docs/ORIENTATION.md; then
    echo ""
    echo "ERROR: docs/ORIENTATION.md must reference ADR-0075"
    echo "  ORIENTATION.md derives its authority from ADR-0075."
    echo "  Removing the reference creates an unanchored 'North Star'."
    echo "  Re-add the link to docs/decisions/0075-knowledge-system-consolidation.md"
    echo ""
    exit 1
  fi
fi

# 9. Page Polish workflow enforcement (smartout-page-polish skill)
# Any change to apps/web/src/app/dashboard/<route>/** must have a corresponding
# .claude/page-polish/<route-slug>.run.yml with `verified: true`. This blocks
# accidental "fix and ship" commits that bypass the polish workflow.
# Bypass with SKIP_PAGE_POLISH=1 (document why in the commit message).
if [ -z "$SKIP_PAGE_POLISH" ]; then
  CHANGED_DASHBOARD_ROUTES=$(git diff --cached --name-only \
    | grep -E '^apps/web/src/app/dashboard/[^/]+/' \
    | sed -E 's|^apps/web/src/app/(dashboard/[^/]+)/.*|\1|' \
    | sort -u)

  for route_path in $CHANGED_DASHBOARD_ROUTES; do
    # Skip route groups (parens) and underscored route segments — those are
    # internal-only and not user-facing pages.
    case "$route_path" in
      *\(*|*_*) continue ;;
    esac

    slug=$(echo "$route_path" | tr '/' '-')
    yaml_path=".claude/page-polish/${slug}.run.yml"

    if [ ! -f "$yaml_path" ]; then
      echo ""
      echo "ERROR: Page polish required for $route_path"
      echo "  Missing: $yaml_path"
      echo "  Run smartout-page-polish workflow first."
      echo "  Bypass: SKIP_PAGE_POLISH=1 git commit (document why)"
      echo ""
      exit 1
    fi

    if ! grep -qE '^verified:[[:space:]]*true' "$yaml_path"; then
      echo ""
      echo "ERROR: Page polish not yet verified for $route_path"
      echo "  File:   $yaml_path"
      echo "  Status: verified is not true"
      echo "  Complete all 11 checklist items + flip verified: true."
      echo "  Bypass: SKIP_PAGE_POLISH=1 git commit (document why)"
      echo ""
      exit 1
    fi
  done
fi

# ============================================================
# 10. Nordic Split design-token + motion-token drift gate
# Source: .claude/skills/smartout-nordic-split + smartout-page-polish §Phase 7.5
# Enforces (strand 1): no NEW zinc/gray/slate hardcoded colors, no NEW inline
# spring physics, no NEW inline framer-motion durations/eases on touched
# dashboard files. Checks added lines in staged diff only — pre-existing
# debt does not block commits.
# Bypass: SKIP_DESIGN_AUDIT=1 git commit (document why in message body).
# ============================================================
if [ -z "$SKIP_DESIGN_AUDIT" ]; then
  # Staged dashboard files (added/modified, .tsx/.ts/.css)
  CHANGED_DESIGN_FILES=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '^apps/web/src/app/dashboard/.*\.(tsx?|css)$' || true)

  if [ -n "$CHANGED_DESIGN_FILES" ]; then
    # Added lines only (start with `+`, NOT `+++` file header).
    # Strip line markers, then check tokens.
    ADDED_LINES=$(git diff --cached --unified=0 -- $CHANGED_DESIGN_FILES \
      | grep '^+' | grep -v '^+++')

    DESIGN_HITS=""

    # Hardcoded Tailwind palette tokens (Nordic Split forbids)
    PALETTE_HITS=$(echo "$ADDED_LINES" \
      | grep -E '\b(zinc|gray|slate)-[0-9]+\b' \
      | grep -v '//.*\b(zinc|gray|slate)-' \
      | head -5 || true)

    # Inline spring physics outside motionTokens.* (case-insensitive `from "@smartout/design-tokens"` import is fine — token usage shows `motionTokens.`)
    SPRING_HITS=$(echo "$ADDED_LINES" \
      | grep -E '(stiffness|damping):\s*[0-9]' \
      | grep -v 'motionTokens\.' \
      | head -5 || true)

    # Inline framer-motion duration / ease arrays outside motionTokens.*
    TIMING_HITS=$(echo "$ADDED_LINES" \
      | grep -E '(duration:\s*0\.|ease:\s*\[)' \
      | grep -v 'motionTokens\.' \
      | head -5 || true)

    # §10.4 transition-all (added 2026-05-14 — council recommendation, P2 strand 1 extension)
    # Discourage transition-all in favor of explicit transition-{property} for predictable motion.
    TRANS_ALL_HITS=$(echo "$ADDED_LINES" \
      | grep -E '\btransition-all\b' \
      | head -5 || true)

    if [ -n "$PALETTE_HITS" ] || [ -n "$SPRING_HITS" ] || [ -n "$TIMING_HITS" ] || [ -n "$TRANS_ALL_HITS" ]; then
      echo ""
      echo "ERROR: Nordic Split / motion-token drift in newly added lines."
      echo "  Use CSS variable classes (bg-background / text-foreground / border-border)"
      echo "  and motionTokens.* from @smartout/design-tokens."
      echo "  Reference: .claude/skills/smartout-nordic-split"
      echo ""
      if [ -n "$PALETTE_HITS" ]; then
        echo "  Hardcoded palette tokens (zinc/gray/slate):"
        echo "$PALETTE_HITS" | sed 's/^/    /'
        echo ""
      fi
      if [ -n "$SPRING_HITS" ]; then
        echo "  Inline spring physics (use motionTokens.spring / springSnappy / springGentle):"
        echo "$SPRING_HITS" | sed 's/^/    /'
        echo ""
      fi
      if [ -n "$TIMING_HITS" ]; then
        echo "  Inline durations / ease arrays (use motionTokens.enterMs / exitMs / easingArray / easingExpoArray):"
        echo "$TIMING_HITS" | sed 's/^/    /'
        echo ""
      fi
      if [ -n "$TRANS_ALL_HITS" ]; then
        echo "  §10.4 transition-all (use explicit transition-colors / transition-transform / etc.):"
        echo "$TRANS_ALL_HITS" | sed 's/^/    /'
        echo ""
      fi
      echo "  Bypass: SKIP_DESIGN_AUDIT=1 git commit (document why in message body)"
      echo ""
      exit 1
    fi
  fi
fi

