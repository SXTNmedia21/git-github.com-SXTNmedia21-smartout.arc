# ============================================================
# PRE-PUSH HOOK — Deployment Pipeline Enforcement + Quality Gates
# Blocks direct push to protected branches.
# Pipeline: development → preview → main
# ============================================================

protected_branch=""
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      # NEVER allow direct push to main
      protected_branch="main"
      ;;
    refs/heads/preview)
      # Allow fast-forward from development only
      # Fetch latest first to compare against current development
      git fetch origin development --quiet 2>/dev/null || true
      if git merge-base --is-ancestor "$local_sha" origin/development 2>/dev/null; then
        # This commit is on development — fast-forward is allowed
        :
      else
        protected_branch="preview"
      fi
      ;;
  esac
done

if [ -n "$protected_branch" ]; then
  echo ""
  echo "❌ DIRECT PUSH BLOCKED: $protected_branch"
  echo ""
  echo "The Smartout deployment pipeline is:"
  echo "  development → preview → main"
  echo ""
  echo "  • Push to development, open a PR to preview"
  echo "  • Fast-forward preview from development (this script allows it)"
  echo "  • Open a PR preview → main"
  echo ""
  echo "Hotfix? Use a hotfix/* branch and open PR to main."
  echo "See ADR-0071 and CLAUDE.md."
  echo ""
  echo "If you absolutely must bypass: --no-verify (NOT recommended)."
  exit 1
fi

# Standard quality gates
pnpm lint
pnpm typecheck

# ADR-0348: Tool-name collision detector — blocks PRs that introduce new collisions.
# Scans all apps/web/src/app/dashboard/**/_tools/use-*-tools.ts for duplicate modelToolName.
# See scripts/check-tool-name-collisions.ts + docs/decisions/0348-l-0258-collision-detector-mandatory-ci.md
pnpm lint:tool-collisions

# ADR-0389: OTP length coherence — the login code field box count (OTP_LENGTH)
# MUST equal GoTrue otp_length in supabase/config.toml. A mismatch silently
# breaks OTP login (valid code, 403). Prod dashboard OTP Length must also match.
node scripts/check-otp-coherence.mjs

# ADR-0392: Domain doc folders — validates docs/domains/<name>/ spine + frontmatter
# (mirror/last_verified) + staleness for any domain touched in this push.
# No-op until docs/domains/ exists. See scripts/domain-lint.mjs + the domain-steward skill.
node scripts/domain-lint.mjs --changed

# ADR-0392: Archived-module migration debt — refs FROM live docs TO an archived
# module folder must point to its superseded_by domain instead. Catches drift.
node scripts/check-archived-refs.mjs
