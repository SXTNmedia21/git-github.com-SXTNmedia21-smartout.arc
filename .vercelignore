# Anchor all patterns with / to match ROOT directories only.
# Without /, gitignore syntax matches at ANY depth (e.g., docs/ would
# also remove apps/landing/src/app/docs/ — breaking the build).

# Mobile app — NOT ignored: PWA project uses root directory = apps/mobile
# /apps/mobile/

# E2E tests — not part of Vercel build
/apps/e2e/

# Python services — deployed separately (DigitalOcean)
/services/

# Supabase — migrations/functions deployed via Supabase CLI
/supabase/

# Infrastructure — Docker/Caddy, not Vercel
/infra/

# Documentation — not deployed
/docs/

# Botsson blueprints — design docs, not code
/packages/Botsson/

# CI scripts and artifacts — not deployed
/artifacts/
# NOTE: /scripts/ is NOT ignored — fix-esm-imports.mjs is needed by @smartout/types build

# Claude Code config
/.claude/

# GitHub Actions — not deployed
/.github/

# Python AI agents — deployed separately
/agents/

# Build artifacts and caches
/.turbo/
/.local/
/.cursor/
