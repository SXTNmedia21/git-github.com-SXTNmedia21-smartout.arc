# Anchor all patterns with / to match ROOT directories only.
# Without /, gitignore syntax matches at ANY depth (e.g., docs/ would
# also remove apps/landing/src/app/docs/ — breaking the build).
#
# This file applies to ALL Vercel projects linked to this repo:
# - smartout-web (apps/web)
# - smartout-landing (apps/landing)
# - smartout-pwa (apps/mobile) — uses Root Directory override in Vercel

# ── Apps not needed by web/landing builds ──
# NOTE: /apps/mobile/ is NOT ignored — smartout-pwa project needs it.
# Use Ignored Build Step in Vercel dashboard per project instead.
/apps/e2e/

# ── Backend services + migration tooling — not deployed to Vercel ──
# Covered: services/contract-service, services/stage-engine, services/shift-mcp,
# services/scrapling (DigitalOcean), services/strike-mcp (local migration tool
# integrated from separate repo 2026-04-17, admin-run via `pnpm tsx …`, never
# part of web build).
/services/

# ── Supabase — deployed via Supabase CLI ──
/supabase/

# ── Infrastructure — Docker/Caddy, not Vercel ──
/infra/

# ── Documentation — not deployed ──
/docs/

# ── Non-build packages — design docs, not runtime code ──
/packages/Botsson/
/packages/docs-pipeline/

# ── CI scripts and artifacts ──
/artifacts/
# NOTE: /scripts/ is NOT ignored — fix-esm-imports.mjs is needed by @smartout/types build

# ── Dev tooling — not deployed ──
/.claude/
/.github/
/.cursor/
/.turbo/
/.local/
/agents/

# ── Build caches — always ignore, regardless of depth ──
# These are local build artifacts (Next.js cache, Turbopack cache, Expo cache).
# Already gitignored so NOT uploaded in git-deploys, but `vercel --target preview`
# CLI uploads local filesystem and these would add ~2 GB per manual preview.
# Safe to match at any depth — these directories have no legitimate non-cache use.
.next/
.next-e2e/
.next-e2e-web/
.expo/
node_modules/.cache/
