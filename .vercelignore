# Anchor all patterns with / to match ROOT directories only.
# Without /, gitignore syntax matches at ANY depth (e.g., docs/ would
# also remove apps/landing/src/app/docs/ — breaking the build).

# Python services — deployed separately (DigitalOcean)
/services/

# Documentation — not deployed
/docs/

# CI scripts and artifacts — not deployed
/scripts/
/artifacts/

# Claude Code config
/.claude/

# GitHub Actions — not deployed
/.github/

# Python AI agents — deployed separately
/agents/

# Build artifacts and caches
/.turbo/
/.local/
/.cursor/
