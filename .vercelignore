# Anchor all patterns with / to match ROOT directories only.
# Without /, gitignore syntax matches at ANY depth (e.g., docs/ would
# also remove apps/landing/src/app/docs/ — breaking the build).

# ── Build cache (5.4GB combined) ────────────────────────────
.next
.turbo
*.tsbuildinfo

# ── Not deployed to Vercel ──────────────────────────────────
/services/
/docs/
/scripts/
/artifacts/
/agents/
/infra/
/supabase/
/apps/e2e/

# ── Dev tooling & config ───────────────────────────────────
/.claude/
/.github/
/.husky/
/.cursor/

# ── Packages not imported by web or landing ────────────────
/packages/docs-pipeline/
/packages/agent-sdk/
