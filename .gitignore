*.log
*.tsbuildinfo
__pycache__
*.pyc

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# IDEs (allow shared .vscode/settings.json and .vscode/extensions.json)
.idea/
.vscode/launch.json
.vscode/*.code-workspace
.cursor/

# Local dev artifacts
.local/

# Vercel
.vercel

# Local dev script PID files (logs already covered by *.log)
.dev-*.pid

# Coverage
coverage/
artifacts/
# .claude/ is fully tracked — project-level agents, commands, scripts, skills
# live with the repo. Runtime caches + secrets are the exception:
.claude/worktrees/
.claude/op-auth.json
.claude/scheduled_tasks.lock

.env*.local
.env.sh
supabase/.env
supabase/functions/.env
client_secret_*.json
.superpowers/

# E2E build artifacts
apps/e2e/playwright-report/
apps/landing/.next-e2e-landing/
apps/web/.next-e2e-web/
supabase/.env.local


# Archived/showcase assets (moved out of git)
docs/archive/
docs/showcase/

# Strike-MCP staged Bubble → Supabase migrations
# SQL bodies contain PII (names, emails, salary) and can be 10MB+ per tenant.
# Manifests + reports are small, PII-free, and form the audit trail (see Learning 0033).
supabase/bubble-data/**/*.sql
!supabase/bubble-data/**/MANIFEST.json
!supabase/bubble-data/**/*.report.md

# Agent runtime memory bundles (session-specific, drifts fast)
.claude/agent-memory/
.claude/settings.local.json
deploy-conductor/

# CI Incident Agent append-only audit log. Tracking this file via git push
# is the anti-pattern documented in learning_artifact_transport_for_ephemeral_ci_logs.md.
# Should migrate to actions/upload-artifact@v4 transport. Until then, untrack to
# stop forcing conflicts on campaign PRs that span >60s.
ops/ci-incidents/log.jsonl
# Windows NTFS zone-tracking metadata (created by WSL when copying from Windows)
*:Zone.Identifier

# Local-only DB safety backups (per-row data)
ops/backups/
.ci-local/
