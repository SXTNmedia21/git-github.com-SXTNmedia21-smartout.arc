# Dependencies (installed inside container)
node_modules
**/node_modules

# Build output (built inside container)
.next
**/dist
**/build
**/*.tsbuildinfo

# Git
.git
.gitignore

# Environment (secrets)
.env
.env.local
.env.*.local
infra/.env

# IDE / OS
