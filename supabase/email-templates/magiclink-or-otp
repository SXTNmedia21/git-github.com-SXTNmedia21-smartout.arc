<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light only" />
  <title>Logg inn på Smartout</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif&display=swap" rel="stylesheet" />
  <style>
    @media only screen and (max-width: 600px) {
      .so-card { width: 100% !important; border-radius: 0 !important; }
      .so-pad { padding-left: 28px !important; padding-right: 28px !important; }
    }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#f7f4ef; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; -webkit-font-smoothing:antialiased;">
  <div style="display:none; max-height:0; overflow:hidden; opacity:0; mso-hide:all;">Engangskoden din til Smartout &mdash; eller logg inn med ett klikk.</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f7f4ef; padding:48px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" width="520" class="so-card" cellpadding="0" cellspacing="0" style="width:520px; max-width:520px; background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 4px 24px rgba(26,23,20,0.07); border:1px solid #eee8e0;">
          <tr>
            <td style="background-color:#1a1714; padding:30px 40px; text-align:center; border-bottom:3px solid #d4622b;">
              <span style="font-size:22px; font-weight:700; letter-spacing:-0.4px; color:#ffffff;">Smart<span style="color:#e8763f;">out</span></span>
            </td>
          </tr>
          <tr>
            <td class="so-pad" style="padding:44px 40px 36px;">
              <h1 style="margin:0 0 12px; font-family:'Instrument Serif',Georgia,'Times New Roman',serif; font-size:30px; font-weight:400; line-height:1.15; color:#1a1714;">Logg inn</h1>
              <p style="margin:0 0 24px; font-size:15px; color:#6b6560; line-height:1.6;">
                Skriv inn engangskoden i Smartout for &aring; logge inn. Koden er gyldig i 10 minutter.
              </p>
              <!-- Code -->
              <div style="background:#faf7f2; border:1px solid #ece5db; border-radius:12px; padding:22px; text-align:center; margin:0 0 28px;">
                <span style="font-size:34px; font-weight:700; color:#1a1714; letter-spacing:10px; font-family:'Courier New',monospace;">{{ .Token }}</span>
              </div>
              <!-- Divider -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
                <tr>
                  <td style="border-top:1px solid #eee8e0; font-size:0; line-height:0;">&nbsp;</td>
                  <td style="padding:0 12px; font-size:12px; color:#bdb8b1; white-space:nowrap;">eller</td>
                  <td style="border-top:1px solid #eee8e0; font-size:0; line-height:0;">&nbsp;</td>
                </tr>
              </table>
              <!-- Direct login button -->
              <table role="presentation" cellpadding="0" cellspacing="0" align="center" style="margin:0 auto 24px;">
                <tr>
                  <td style="background-color:#d4622b; border-radius:10px; box-shadow:0 2px 8px rgba(212,98,43,0.30);">
                    <a href="{{ .SiteURL }}/api/auth/callback?token_hash={{ .TokenHash }}&type=email&next=/dashboard" target="_blank" style="display:inline-block; padding:15px 36px; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none;">
                      Logg inn direkte
                    </a>
                  </td>
                </tr>
              </table>
              <p style="margin:0; font-size:13px; color:#9b9590; line-height:1.6; text-align:center;">
                Ba du ikke om dette, kan du trygt ignorere e-posten.
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding:24px 40px 28px; border-top:1px solid #eee8e0; text-align:center;">
              <p style="margin:0 0 4px; font-size:12px; color:#9b9590;">Smartout AS &middot; <a href="https://smartout.ai" style="color:#9b9590; text-decoration:underline;">smartout.ai</a></p>
              <p style="margin:0; font-size:11px; color:#bdb8b1;">Operativsystemet for service- og hospitality-bransjen.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
