{
  "name": "@smartout/voice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/agent.ts dev",
    "start": "tsx src/agent.ts start",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "vad-bench": "tsx scripts/vad-bench.ts",
    "vad-bench:generate-fixtures": "tsx scripts/vad-bench/generate-fixtures.ts",
    "vad-bench:record": "tsx scripts/vad-bench.ts --record",
    "test": "vitest run"
  },
  "dependencies": {
    "@livekit/agents": "^1.3.0",
    "@livekit/agents-plugin-openai": "^1.3.0",
    "@livekit/agents-plugin-silero": "^1.3.0",
    "@livekit/rtc-node": "^0.13.27",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/ws": "^8.18.1",
    "openai": "^6.36.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5",
    "ws": "^8.19.0",
    "zod": "^4.4.3"
  }
}
