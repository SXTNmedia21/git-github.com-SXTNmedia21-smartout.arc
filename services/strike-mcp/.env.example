# strike-mcp environment configuration
#
# Copy to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.
#
# Reference: docs/superpowers/specs/2026-04-07-strike-mcp-design.md

# ─────────────────────────────────────────────────────────────
# REQUIRED — Bubble Data API
# ─────────────────────────────────────────────────────────────

# Base URL of the Smartout Bubble app (no trailing slash)
BUBBLE_APP_URL=https://smartout.bubbleapps.io

# Bearer token for the Bubble Data API
# 1Password: op://smartout_ai_prod/bubble/api-token (or wherever it lives)
BUBBLE_API_TOKEN=

# ─────────────────────────────────────────────────────────────
# Workspace selection — DO NOT set here
# ─────────────────────────────────────────────────────────────
#
# Workspace ID is NOT an environment variable. It is chosen per-session
# via the list_workspaces MCP tool, which the agent calls at session start:
#
#   1. Agent calls list_workspaces → shows available workspaces
#   2. Agent asks user: "Which workspace to target?"
#   3. User picks — agent uses that ID for all subsequent migration tools
#
# The discovery script (scripts/run_discovery.ts) follows the same pattern:
# it lists workspaces first and prompts interactively unless --workspace=<id>
# is passed explicitly.
#
# This keeps workspace targeting explicit and auditable per run.

# ─────────────────────────────────────────────────────────────
# OPTIONAL — Supabase read-only (enables verify_target_empty tool)
# ─────────────────────────────────────────────────────────────

# Local Supabase URL if running locally via `supabase start`
# or cloud URL for staging/test Supabase.
# Leave blank to disable verify_target_empty tool.
SUPABASE_URL=

# Anon (read-only) key. NEVER paste a service_role key here —
# strike-mcp is designed to have zero write capability against Supabase.
SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# OPTIONAL — Path overrides (defaults usually fine)
# ─────────────────────────────────────────────────────────────

# Where machine-readable mappings are stored (in-repo, committed)
# Default: /home/sxtnl/dev/strike-mcp/mappings
# STRIKE_MAPPINGS_DIR=

# Where human-readable vault narratives go (second-brain vault)
# Default: /home/sxtnl/dev/second-brain-v2/wiki/migration/bubble-shapes
# STRIKE_VAULT_SHAPES_DIR=

# Where generated migration SQL files are staged for human review
# Default: /home/sxtnl/dev/strike-mcp/supabase/migration-staging
# STRIKE_STAGING_DIR=

# ─────────────────────────────────────────────────────────────
# OPTIONAL — PII handling (Phase 3.5 addition)
# ─────────────────────────────────────────────────────────────

# How sample values are stored in mapping files:
#   redacted  — only type signatures in git (e.g. "string<24>", "email-like")
#   sidecar   — redacted in git + raw samples in mappings/.local/*.sidecar.json (gitignored)
#   raw       — raw values in git (NOT recommended, GDPR risk)
# Default: redacted (safe default)
STRIKE_SAMPLE_MODE=redacted
