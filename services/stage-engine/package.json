{
  "name": "@smartout/stage-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env --env-file=.env.local src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:e2e": "tsx test/e2e.ts",
    "test:agent": "tsx test/agent-chat.e2e.ts",
    "eval": "tsx test/eval/run-evals.ts all",
    "eval:intent": "tsx test/eval/run-evals.ts intent",
    "eval:quality": "tsx test/eval/run-evals.ts quality"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.5.0",
    "@openrouter/ai-sdk-provider": "^2.2.3",
    "@smartout/ai": "workspace:*",
    "@smartout/supabase": "workspace:*",
    "@supabase/supabase-js": "^2.49.4",
    "ai": "^6.0.103",
    "hono": "^4.7.0",
    "ws": "^8.19.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
