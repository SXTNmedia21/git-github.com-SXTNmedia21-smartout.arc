# Copy this to .env.local and fill in real values, OR ideally use:
# op run --env-file=.env.template -- npm run dev

# ─── Database ────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
DATABASE_PASSWORD="your-local-password-here"
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="eyJhb...local-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhb...local-service-key"

# ─── APIs & Integrations ─────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
SENDGRID_API_KEY="SG...."
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your-twilio-token"

# ─── Telemetry ───────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# ─── App Secrets ─────────────────────────────────
JWT_SECRET="generate-a-random-string-for-local-dev"
SESSION_SECRET="generate-another-random-string"
