# ============================================================================
# Smartout v3 — Environment Variables (Single Source of Truth)
# ============================================================================
#
# Copy to .env.local and fill in values:
#   cp .env.example .env.local
#
# Local Supabase credentials:
#   npx supabase status
#
# With 1Password:
#   op run --env-file=.env.template -- pnpm dev
#
# In production, secrets are fetched from Supabase Vault via get_secret().
# Only bootstrap vars (Supabase URL/keys) are set as real env vars.
#
# ============================================================================


# ── Supabase (bootstrap — required for everything) ──────────────────────────
# Get from: npx supabase status (local) or Supabase dashboard (prod)
SUPABASE_URL=http://127.0.0.1:55331
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres
DATABASE_PASSWORD=

# Client-side Supabase (same values, NEXT_PUBLIC_ prefix for browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55331
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ── Client-side (public, safe to expose) ────────────────────────────────────
NEXT_PUBLIC_ROOT_DOMAIN=localhost
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_LANDING_URL=http://localhost:3055
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3050
NEXT_PUBLIC_REVALIDATION_SECRET=local-revalidation-secret
NEXT_PUBLIC_LANDING_VARIANT=T


# ── Service URLs (internal, no secrets — just addresses) ────────────────────
SCRAPLING_SERVICE_URL=http://localhost:8000
STAGE_ENGINE_URL=http://localhost:3060
CONTRACT_SERVICE_URL=http://localhost:3100
SHIFT_MCP_URL=http://localhost:3001
ENGINE_URL=http://localhost:3060
SESSION_EXPIRY_HOURS=24
CLEANUP_INTERVAL_MINUTES=5


# ── Sentry ──────────────────────────────────────────────────────────────────

SENTRY_AUTH_TOKEN=
SENTRY_ORG=smartout
SENTRY_PROJECT=smartout-web


# ── App config (non-secret) ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
SITE_URL=http://localhost:3050
WEB_URL=http://localhost:3050
LANDING_URL=http://localhost:3055
GENERIC_TIMEZONE=Europe/Oslo



# ============================================================================
# SECRETS
# In production: fetched from Supabase Vault via get_secret().
# For local dev: set values here. Never commit real values.
# ============================================================================


# ── Auth (generate with: openssl rand -hex 32) ─────────────────────────────
JWT_SECRET=
SESSION_SECRET=
WATCHDOG_CRON_SECRET=
REVALIDATION_SECRET=
HEALTH_CHECK_SECRET=


# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# ── Email / SMS ─────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_VERIFICATION_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# ── AI / Search / Voice ─────────────────────────────────────────────────────
OPENROUTER_API_KEY=
ULTRAVOX_API_KEY=
ULTRAVOX_AGENT_ID=
SERPER_API_KEY=
GOOGLE_PLACES_API_KEY=


# ── Contracts ───────────────────────────────────────────────────────────────
CONTRACT_SERVICE_KEY=
DOCUSEAL_API_KEY=
DOCUSEAL_API_URL=https://api.docuseal.com
DOCUSEAL_WEBHOOK_SECRET=
SMARTOUT_COMPANY_NAME=Smartout AS
SMARTOUT_ORG_NUMBER=
SMARTOUT_CONTACT_EMAIL=


# ── Cache ───────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── Vision (OCR for settlement images) ──────────────────────────────────────
GOOGLE_VISION_API_KEY=


# ── Landing-only ────────────────────────────────────────────────────────────
STAGE_ENGINE_API_KEY=
INTERVJU_MCP_WEBHOOK_SECRET=


# ── n8n (only if running locally) ──────────────────────────────────────────
N8N_HOST=localhost
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=http://localhost:5678/
