# ============================================================================
# Smartout v3 — Root Environment Variables
# ============================================================================
#
# SINGLE SOURCE OF TRUTH for local development.
# Copy to .env.local and fill in values.
#
# Secrets (API keys, tokens) live in Supabase Vault — NOT here.
# Services call get_secret() at runtime. Only bootstrap vars go in env.
#
# Usage:
#   cp .env.example .env.local
#   # Fill in values from Supabase local status: npx supabase status
#   pnpm dev:local
#
# With 1Password:
#   op run --env-file=.env.example -- pnpm dev
#
# ============================================================================

# ── Supabase (bootstrap — required for everything) ──────────────────────────
# Get these from: npx supabase status
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55331
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from supabase status>
SUPABASE_SERVICE_ROLE_KEY=<from supabase status>
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres

# ── Client-side (public, safe to expose) ────────────────────────────────────
NEXT_PUBLIC_ROOT_DOMAIN=localhost
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_LANDING_URL=http://localhost:3055
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3050
NEXT_PUBLIC_REVALIDATION_SECRET=local-revalidation-secret
NEXT_PUBLIC_LANDING_VARIANT=T

# ── Internal service URLs (no secrets — just addresses) ─────────────────────
SCRAPLING_SERVICE_URL=http://localhost:8000
STAGE_ENGINE_URL=http://localhost:3000
CONTRACT_SERVICE_URL=http://localhost:3100
SHIFT_MCP_URL=http://localhost:3001

# ── App config (non-secret) ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
SITE_URL=http://localhost:3050
WEB_URL=http://localhost:3050
LANDING_URL=http://localhost:3055
GENERIC_TIMEZONE=Europe/Oslo

# ── Auth (generate locally, not from Vault) ─────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=<generate-locally-min-32-chars>
SESSION_SECRET=<generate-locally-min-32-chars>
WATCHDOG_CRON_SECRET=<generate-locally>
REVALIDATION_SECRET=<generate-locally-min-16-chars>

# ============================================================================
# SECRETS — All below are fetched from Supabase Vault in production.
# For LOCAL DEV ONLY, you can set them here. Never commit real values.
# In production, services call get_secret() instead.
# ============================================================================

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email / SMS
SENDGRID_API_KEY=SG....
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AI / Search
OPENROUTER_API_KEY=
ULTRAVOX_API_KEY=
SERPER_API_KEY=

# Contracts
DOCUSEAL_API_KEY=
DOCUSEAL_API_URL=https://api.docuseal.com
DOCUSEAL_WEBHOOK_SECRET=

# Cache
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vision (OCR for settlement images)
GOOGLE_VISION_API_KEY=

# Contract service internals
SMARTOUT_COMPANY_NAME=Smartout AS
SMARTOUT_ORG_NUMBER=
SMARTOUT_CONTACT_EMAIL=pontus@smartout.io

# n8n (only if running locally)
N8N_HOST=localhost
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=http://localhost:5678/
