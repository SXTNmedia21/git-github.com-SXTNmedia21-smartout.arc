# ============================================================================
# Smartout v3 — 1Password Template
# ============================================================================
#
# Usage:  op run --env-file=.env.template -- pnpm dev
#
# This file mirrors .env.example 1:1 but uses op:// references for secrets.
# Non-secret values are plain strings (same as .env.example).
#
# ============================================================================


# ── Supabase (bootstrap — required for everything) ──────────────────────────
SUPABASE_URL="op://smartout_ai/Supabase/url"
SUPABASE_ANON_KEY="op://smartout_ai/Supabase/anon_key"
SUPABASE_SERVICE_ROLE_KEY="op://smartout_ai/Supabase/service_role_key"
SUPABASE_DB_URL="op://smartout_ai/PostgreSQL/connection_string"
DATABASE_URL="op://smartout_ai/PostgreSQL/connection_string"
DATABASE_PASSWORD="op://smartout_ai/PostgreSQL/password"

# Client-side Supabase
NEXT_PUBLIC_SUPABASE_URL="op://smartout_ai/Supabase/url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="op://smartout_ai/Supabase/anon_key"


# ── Client-side (public, safe to expose) ────────────────────────────────────
NEXT_PUBLIC_ROOT_DOMAIN=localhost
NEXT_PUBLIC_POSTHOG_KEY="op://smartout_ai/PostHog/api_key"
NEXT_PUBLIC_POSTHOG_HOST="op://smartout_ai/PostHog/host"
NEXT_PUBLIC_SENTRY_DSN="op://smartout_ai/Sentry/dsn"
NEXT_PUBLIC_LANDING_URL=http://localhost:3055
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3060
NEXT_PUBLIC_REVALIDATION_SECRET=local-revalidation-secret
NEXT_PUBLIC_LANDING_VARIANT=T


# ── Service URLs (internal, no secrets — just addresses) ────────────────────
SCRAPLING_SERVICE_URL=https://scrape.smartout.ai
STAGE_ENGINE_URL=http://localhost:5010
NEXT_PUBLIC_STAGE_ENGINE_URL=http://localhost:5010
CONTRACT_SERVICE_URL=http://localhost:5012
SHIFT_MCP_URL=http://localhost:5011
ENGINE_URL=http://localhost:5010
APP_URL=http://localhost:3060
SESSION_EXPIRY_HOURS=24
CLEANUP_INTERVAL_MINUTES=5


# ── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_AUTH_TOKEN="op://smartout_ai/Sentry/auth_token"
SENTRY_ORG=smartout
SENTRY_PROJECT=smartout-web
SENTRY_DSN="op://smartout_ai/Sentry/dsn"

# ── App config (non-secret) ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
SITE_URL=http://localhost:3050
WEB_URL=http://localhost:3050
LANDING_URL=http://localhost:3055
GENERIC_TIMEZONE=Europe/Oslo
ENVIRONMENT=development

# ============================================================================
# SECRETS
# ============================================================================


# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="op://smartout_ai/SmartOut/jwt_secret"
SESSION_SECRET="op://smartout_ai/SmartOut/session_secret"
WATCHDOG_CRON_SECRET="op://smartout_ai/SmartOut/watchdog_cron_secret"
REVALIDATION_SECRET="op://smartout_ai/SmartOut/revalidation_secret"
HEALTH_CHECK_SECRET="op://smartout_ai/SmartOut/health_check_secret"


# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="op://smartout_ai/Stripe/secret_key"
STRIPE_WEBHOOK_SECRET="op://smartout_ai/Stripe/webhook_secret"


# ── Email / SMS ─────────────────────────────────────────────────────────────
SENDGRID_API_KEY="op://smartout_ai/SendGrid/api_key"
SENDGRID_WEBHOOK_VERIFICATION_KEY="op://smartout_ai/SendGrid/webhook_verification_key"
SENDGRID_SENDER_EMAIL="op://smartout_ai/SendGrid/sender_email"
TWILIO_ACCOUNT_SID="op://smartout_ai/Twilio/account_sid"
TWILIO_AUTH_TOKEN="op://smartout_ai/Twilio/auth_token"
TWILIO_FROM_NUMBER="op://smartout_ai/Twilio/from_number"


# ── AI / Search / Voice ─────────────────────────────────────────────────────
ULTRAVOX_AGENT_ID="op://smartout_ai/Ultravox/agent_id"
SERPER_API_KEY="op://smartout_ai/Serper/api_key"
GOOGLE_API_KEY="op://smartout_ai/Google/api_key"
II_ELEVEN_LABS_KEY="op://smartout_ai/11labs/api_key"
OPENROUTER_API_KEY="op://smartout_ai/OpenRouter/api_key"
ULTRAVOX_API_KEY="op://smartout_ai/Ultravox/api_key"

# ── Contracts ───────────────────────────────────────────────────────────────
CONTRACT_SERVICE_KEY="op://smartout_ai/Contract-Service/api_key"
DOCUSEAL_API_KEY="op://smartout_ai/DocuSeal/api_key"
DOCUSEAL_API_URL=https://api.docuseal.com
DOCUSEAL_WEBHOOK_SECRET="op://smartout_ai/DocuSeal/webhook_secret"
SMARTOUT_COMPANY_NAME=Smartout AS
SMARTOUT_ORG_NUMBER="op://smartout_ai/SmartOut/org_number"
SMARTOUT_CONTACT_EMAIL="op://smartout_ai/SmartOut/contact_email"


# ── Cache ───────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="op://smartout_ai/Upstash/rest_url"
UPSTASH_REDIS_REST_TOKEN="op://smartout_ai/Upstash/rest_token"


# ── Landing-only ────────────────────────────────────────────────────────────
SCRAPLING_AUTH_TOKEN="op://smartout_ai/Scrapling/SCRAPLING_AUTH_TOKEN"
STAGE_ENGINE_API_KEY="op://smartout_ai/Stage-Engine/api_key"
INTERVJU_MCP_WEBHOOK_SECRET="op://smartout_ai/Intervju-MCP/webhook_secret"
DEV_API_KEY="op://smartout_ai/Stage-Engine/api_key2"


# ── n8n (only if running locally) ──────────────────────────────────────────
N8N_HOST=localhost
N8N_BASIC_AUTH_USER="op://smartout_ai/n8n/basic_auth_user"
N8N_BASIC_AUTH_PASSWORD="op://smartout_ai/n8n/basic_auth_password"
N8N_ENCRYPTION_KEY="op://smartout_ai/n8n/encryption_key"
N8N_WEBHOOK_URL=http://localhost:5678/

# ── Supabase external.auth ──────────────────────────────────────────
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=op://smartout_ai/Google-OAuth/client_id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=op://smartout_ai/Google-OAuth/secret