# ============================================================================
# Smartout v3 — 1Password Template
# ============================================================================
#
# Usage:  op run --env-file=.env.template -- pnpm dev
#
# This file mirrors .env.example 1:1 but uses op:// references for secrets.
# Non-secret values are plain strings (same as .env.example).
#
# ============================================================================


# ── Supabase (bootstrap — required for everything) ──────────────────────────
SUPABASE_URL="op://Development/Supabase/url"
SUPABASE_ANON_KEY="op://Development/Supabase/anon_key"
SUPABASE_SERVICE_ROLE_KEY="op://Development/Supabase/service_role_key"
DATABASE_URL="op://Development/PostgreSQL/connection_string"
DATABASE_PASSWORD="op://Development/PostgreSQL/password"

# Client-side Supabase
NEXT_PUBLIC_SUPABASE_URL="op://Development/Supabase/url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="op://Development/Supabase/anon_key"


# ── Client-side (public, safe to expose) ────────────────────────────────────
NEXT_PUBLIC_ROOT_DOMAIN=localhost
NEXT_PUBLIC_POSTHOG_KEY="op://Development/PostHog/api_key"
NEXT_PUBLIC_POSTHOG_HOST="op://Development/PostHog/host"
NEXT_PUBLIC_SENTRY_DSN="op://Development/Sentry/dsn"
NEXT_PUBLIC_LANDING_URL=http://localhost:3055
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3050
NEXT_PUBLIC_REVALIDATION_SECRET=local-revalidation-secret
NEXT_PUBLIC_LANDING_VARIANT=T


# ── Service URLs (internal, no secrets — just addresses) ────────────────────
SCRAPLING_SERVICE_URL=http://localhost:8000
STAGE_ENGINE_URL=http://localhost:5010
NEXT_PUBLIC_STAGE_ENGINE_URL=http://localhost:5010
CONTRACT_SERVICE_URL=http://localhost:5012
SHIFT_MCP_URL=http://localhost:5011
ENGINE_URL=http://localhost:5010
APP_URL=http://localhost:3050
SESSION_EXPIRY_HOURS=24
CLEANUP_INTERVAL_MINUTES=5


# ── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_AUTH_TOKEN="op://Development/Sentry/auth_token"
SENTRY_ORG=smartout
SENTRY_PROJECT=smartout-web


# ── App config (non-secret) ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
SITE_URL=http://localhost:3050
WEB_URL=http://localhost:3050
LANDING_URL=http://localhost:3055
GENERIC_TIMEZONE=Europe/Oslo


# ============================================================================
# SECRETS
# ============================================================================


# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="op://Development/SmartOut/jwt_secret"
SESSION_SECRET="op://Development/SmartOut/session_secret"
WATCHDOG_CRON_SECRET="op://Development/SmartOut/watchdog_cron_secret"
REVALIDATION_SECRET="op://Development/SmartOut/revalidation_secret"
HEALTH_CHECK_SECRET="op://Development/SmartOut/health_check_secret"


# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="op://Development/Stripe/secret_key"
STRIPE_WEBHOOK_SECRET="op://Development/Stripe/webhook_secret"


# ── Email / SMS ─────────────────────────────────────────────────────────────
SENDGRID_API_KEY="op://Development/SendGrid/api_key"
SENDGRID_WEBHOOK_VERIFICATION_KEY="op://Development/SendGrid/webhook_verification_key"
TWILIO_ACCOUNT_SID="op://Development/Twilio/account_sid"
TWILIO_AUTH_TOKEN="op://Development/Twilio/auth_token"
TWILIO_FROM_NUMBER="op://Development/Twilio/from_number"


# ── AI / Search / Voice ─────────────────────────────────────────────────────
OPENROUTER_API_KEY="op://Development/OpenRouter/api_key"
ULTRAVOX_API_KEY="op://Development/Ultravox/api_key"
ULTRAVOX_AGENT_ID="op://Development/Ultravox/agent_id"
SERPER_API_KEY="op://Development/Serper/api_key"
GOOGLE_PLACES_API_KEY="op://Development/Google Places/api_key"


# ── Contracts ───────────────────────────────────────────────────────────────
CONTRACT_SERVICE_KEY="op://Development/Contract-Service/api_key"
DOCUSEAL_API_KEY="op://Development/DocuSeal/api_key"
DOCUSEAL_API_URL=https://api.docuseal.com
DOCUSEAL_WEBHOOK_SECRET="op://Development/DocuSeal/webhook_secret"
SMARTOUT_COMPANY_NAME=Smartout AS
SMARTOUT_ORG_NUMBER="op://Development/SmartOut/org_number"
SMARTOUT_CONTACT_EMAIL="op://Development/SmartOut/contact_email"


# ── Cache ───────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="op://Development/Upstash/rest_url"
UPSTASH_REDIS_REST_TOKEN="op://Development/Upstash/rest_token"


# ── Vision (OCR for settlement images) ──────────────────────────────────────
GOOGLE_VISION_API_KEY="op://Development/Google Vision/api_key"


# ── Landing-only ────────────────────────────────────────────────────────────
STAGE_ENGINE_API_KEY="op://Development/Stage-Engine/api_key"
INTERVJU_MCP_WEBHOOK_SECRET="op://Development/Intervju-MCP/webhook_secret"


# ── n8n (only if running locally) ──────────────────────────────────────────
N8N_HOST=localhost
N8N_BASIC_AUTH_USER="op://Development/n8n/basic_auth_user"
N8N_BASIC_AUTH_PASSWORD="op://Development/n8n/basic_auth_password"
N8N_ENCRYPTION_KEY="op://Development/n8n/encryption_key"
N8N_WEBHOOK_URL=http://localhost:5678/
