# ============================================================================
# Smartout v3 — 1Password Template
# ============================================================================
#
# Usage:  op run --env-file=.env.template -- pnpm dev
#
# ALL values come from 1Password. The vault name determines the environment:
#   smartout_ai      → development (localhost URLs, test keys)
#   smartout_ai_prod → production  (real URLs, live keys)
#
# To switch environments, create smartout_ai_prod vault with prod values
# and change all "smartout_ai" references below to "smartout_ai_prod".
#
# ============================================================================


# ── Supabase (bootstrap — required for everything) ──────────────────────────
SUPABASE_URL="op://smartout_ai/Supabase/url"
SUPABASE_ANON_KEY="op://smartout_ai/Supabase/anon_key"
SUPABASE_SERVICE_ROLE_KEY="op://smartout_ai/Supabase/service_role_key"
SUPABASE_DB_URL="op://smartout_ai/PostgreSQL/connection_string"
DATABASE_URL="op://smartout_ai/PostgreSQL/connection_string"
DATABASE_PASSWORD="op://smartout_ai/PostgreSQL/password"

# Client-side Supabase
NEXT_PUBLIC_SUPABASE_URL="op://smartout_ai/Supabase/url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="op://smartout_ai/Supabase/anon_key"
EXPO_PUBLIC_SUPABASE_URL="op://smartout_ai/Supabase/url"
EXPO_PUBLIC_SUPABASE_ANON_KEY="op://smartout_ai/Supabase/anon_key"


# ── Client-side (public, safe to expose) ────────────────────────────────────
NEXT_PUBLIC_ROOT_DOMAIN="op://smartout_ai/SmartOut/root_domain"
NEXT_PUBLIC_POSTHOG_KEY="op://smartout_ai/PostHog/api_key"
NEXT_PUBLIC_POSTHOG_HOST="op://smartout_ai/PostHog/host"
NEXT_PUBLIC_SENTRY_DSN="op://smartout_ai/Sentry/dsn"
NEXT_PUBLIC_LANDING_URL="op://smartout_ai/SmartOut/landing_url"
NEXT_PUBLIC_WEB_APP_URL="op://smartout_ai/SmartOut/web_app_url"
NEXT_PUBLIC_REVALIDATION_SECRET="op://smartout_ai/SmartOut/revalidation_secret"
NEXT_PUBLIC_LANDING_VARIANT=T
NEXT_PUBLIC_INTERACTIVE_DASHBOARD=true


# ── Service URLs (vault-driven — different per environment) ────────────────
SCRAPLING_SERVICE_URL="op://smartout_ai/Scrapling/url"
STAGE_ENGINE_URL="op://smartout_ai/Stage-Engine/url"
NEXT_PUBLIC_STAGE_ENGINE_URL="op://smartout_ai/Stage-Engine/url"
CONTRACT_SERVICE_URL="op://smartout_ai/Contract-Service/url"
SHIFT_MCP_URL="op://smartout_ai/Shift-MCP/url"
ENGINE_URL="op://smartout_ai/Stage-Engine/url"
APP_URL="op://smartout_ai/SmartOut/web_app_url"
SESSION_EXPIRY_HOURS=24
CLEANUP_INTERVAL_MINUTES=5


# ── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_AUTH_TOKEN="op://smartout_ai/Sentry/auth_token"
SENTRY_ORG=smartout
SENTRY_PROJECT=smartout-web
SENTRY_DSN="op://smartout_ai/Sentry/dsn"

# ── GitHub Error Reporter ────────────────────────────────────────────────────
GITHUB_ERROR_TOKEN="op://smartout_ai/GitHub/error_reporter_token"
GITHUB_ERROR_REPO="SXTNmedia21/smartout.ai"

# ── App config (vault-driven per environment) ─────────────────────────────
NODE_ENV="development"
LOG_LEVEL=debug
SITE_URL="op://smartout_ai/SmartOut/web_app_url"
WEB_URL="op://smartout_ai/SmartOut/web_app_url"
LANDING_URL="op://smartout_ai/SmartOut/landing_url"
GENERIC_TIMEZONE=Europe/Oslo
ENVIRONMENT="op://smartout_ai/SmartOut/environment"

