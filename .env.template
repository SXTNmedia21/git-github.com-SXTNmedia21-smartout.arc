# ============================================================================
# Smartout v3 — 1Password Template
# ============================================================================
#
# Usage:  op run --env-file=.env.template -- pnpm dev
#
# ALL values come from 1Password. The vault name determines the environment:
#   smartout_ai      → development (localhost URLs, test keys)
#   smartout_ai_prod → production  (real URLs, live keys)
#
# ============================================================================


# ── Supabase (bootstrap — required for everything) ──────────────────────────
SUPABASE_URL="op://smartout_ai/Supabase/url"
SUPABASE_ANON_KEY="op://smartout_ai/Supabase/anon_key"
SUPABASE_SERVICE_ROLE_KEY="op://smartout_ai/Supabase/service_role_key"
DATABASE_URL="op://smartout_ai/PostgreSQL/connection_string"
SUPABASE_DB_URL="op://smartout_ai/PostgreSQL/connection_string"

# Client-side Supabase
NEXT_PUBLIC_SUPABASE_URL="op://smartout_ai/Supabase/url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="op://smartout_ai/Supabase/anon_key"
EXPO_PUBLIC_SUPABASE_URL="op://smartout_ai/Supabase/url"
EXPO_PUBLIC_SUPABASE_ANON_KEY="op://smartout_ai/Supabase/anon_key"


# ── Client-side (public, safe to expose) ────────────────────────────────────
NEXT_PUBLIC_ROOT_DOMAIN="op://smartout_ai/SmartOut/root_domain"
NEXT_PUBLIC_POSTHOG_KEY="op://smartout_ai/PostHog/api_key"
NEXT_PUBLIC_POSTHOG_HOST="op://smartout_ai/PostHog/host"
NEXT_PUBLIC_POSTHOG_PROJECT_ID="op://smartout_ai/PostHog/project_id"
NEXT_PUBLIC_SENTRY_DSN="op://smartout_ai/Sentry/dsn"
NEXT_PUBLIC_LANDING_URL="op://smartout_ai/SmartOut/landing_url"
NEXT_PUBLIC_WEB_APP_URL="op://smartout_ai/SmartOut/web_app_url"
NEXT_PUBLIC_REVALIDATION_SECRET="op://smartout_ai/SmartOut/revalidation_secret"
NEXT_PUBLIC_LANDING_VARIANT=T
NEXT_PUBLIC_INTERACTIVE_DASHBOARD=false


# ── Service URLs ───────────────────────────────────────────────────────────
# SCRAPLING_SERVICE_URL — host-context callers (Next.js dev server on host).
#   Dev: http://localhost:8000 (port-mapped from container).
#   Prod: https://scrape.smartout.ai.
# SCRAPLING_INTERNAL_URL — container-context callers (Supabase Edge Runtime).
#   Dev: http://host.docker.internal:8000 (container reaches host network).
#   Prod: https://scrape.smartout.ai (same public URL).
# Why split: WSL2/Docker Desktop has no single hostname that works from
# both host and a sibling container. Production has one URL (CDN-fronted).
SCRAPLING_SERVICE_URL="op://smartout_ai/Scrapling/SCRAPLING_SERVICE_URL"
SCRAPLING_INTERNAL_URL="op://smartout_ai/Scrapling/SCRAPLING_INTERNAL_URL"
STAGE_ENGINE_URL="op://smartout_ai/Stage-Engine/url"
NEXT_PUBLIC_STAGE_ENGINE_URL="op://smartout_ai/Stage-Engine/url"
# WS URL derives from Stage-Engine URL (ws://localhost:5010 in dev)
NEXT_PUBLIC_STAGE_ENGINE_WS_URL="ws://localhost:5010"
CONTRACT_SERVICE_URL="op://smartout_ai/Contract-Service/url"
SHIFT_MCP_URL="op://smartout_ai/Shift-MCP/url"
ENGINE_URL="op://smartout_ai/Stage-Engine/url"
APP_URL="op://smartout_ai/SmartOut/web_app_url"
SITE_URL="op://smartout_ai/SmartOut/web_app_url"
WEB_URL="op://smartout_ai/SmartOut/web_app_url"
LANDING_URL="op://smartout_ai/SmartOut/landing_url"
SESSION_EXPIRY_HOURS=24
CLEANUP_INTERVAL_MINUTES=5
# Watchdog threshold for department_session demotion
# (pending_signoff → missed). Read by session-watchdog-demoter.
SESSION_PENDING_SIGNOFF_STALE_HOURS=24


# ── Sentry (build-time — read implicitly by Sentry plugin) ────────────────
SENTRY_AUTH_TOKEN="op://smartout_ai/Sentry/auth_token"
SENTRY_ORG=smartout
SENTRY_PROJECT=smartout-web
SENTRY_DSN="op://smartout_ai/Sentry/dsn"
SENTRY_DSN_STAGE_ENGINE="op://smartout_ai/Sentry/stage-engine-dsn"
SENTRY_TRACES_SAMPLE_RATE=

# ── GitHub Error Reporter ────────────────────────────────────────────────────
GITHUB_ERROR_TOKEN="op://smartout_ai/GitHub/error_reporter_token"
GITHUB_ERROR_REPO="SXTNmedia21/smartout.ai"

# ── App config ────────────────────────────────────────────────────────────
# NODE_ENV is intentionally omitted — Next.js sets it per command
# (`next dev` → development, `next build` → production). Forcing it here
# breaks production prerendering (React dev-mode renderer trips on metadata).
LOG_LEVEL=debug
ENVIRONMENT="op://smartout_ai/SmartOut/environment"


# ============================================================================
# SECRETS
# ============================================================================


# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="op://smartout_ai/SmartOut/jwt_secret"
SESSION_SECRET="op://smartout_ai/SmartOut/session_secret"
WATCHDOG_CRON_SECRET="op://smartout_ai/SmartOut/watchdog_cron_secret"
PROCESS_NOTIFICATIONS_SECRET="op://smartout_ai/Supabase/process_notifications_secret"
MORNING_DIGEST_SECRET="op://smartout_ai/Supabase/morning_digest_secret"
PUSH_DISPATCH_SECRET="op://smartout_ai/Supabase/push_dispatch_secret"
REVALIDATION_SECRET="op://smartout_ai/SmartOut/revalidation_secret"
HEALTH_CHECK_SECRET="op://smartout_ai/SmartOut/health_check_secret"


# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="op://smartout_ai/Stripe/secret_key"
STRIPE_WEBHOOK_SECRET="op://smartout_ai/Stripe/webhook_secret"


# ── Email / SMS ─────────────────────────────────────────────────────────────
SENDGRID_API_KEY="op://smartout_ai/SendGrid/api_key"
SENDGRID_WEBHOOK_VERIFICATION_KEY="op://smartout_ai/SendGrid/webhook_verification_key"
SENDGRID_SENDER_EMAIL="op://smartout_ai/SendGrid/sender_email"
TWILIO_ACCOUNT_SID="op://smartout_ai/Twilio/account_sid"
TWILIO_AUTH_TOKEN="op://smartout_ai/Twilio/auth_token"
TWILIO_FROM_NUMBER="op://smartout_ai/Twilio/from_number"

# Dev-only SMTP bridge (Mailpit). When set, @smartout/notifications routes
# `sendEmailBatch` / `sendDynamicTemplateBatch` through this host instead of
# SendGrid. See ADR-0045 amendment + supabase/config.toml [inbucket].smtp_port.
# Active only when NODE_ENV !== "production". Leave unset in prod.
SMTP_DEV_HOST="127.0.0.1:54325"


# ── AI / Search / Voice ─────────────────────────────────────────────────────
ULTRAVOX_AGENT_ID="op://smartout_ai/Ultravox/agent_id"
SERPER_API_KEY="op://smartout_ai/Serper/api_key"
GOOGLE_API_KEY="op://smartout_ai/Google/api_key"
OPENROUTER_API_KEY="op://smartout_ai/OpenRouter/api_key"
ULTRAVOX_API_KEY="op://smartout_ai/Ultravox/api_key"

# Telegram Bot API (admin command & control)
TELEGRAM_BOT_TOKEN="op://smartout_ai/Telegram/bot_token"
TELEGRAM_WEBHOOK_SECRET="op://smartout_ai/Telegram/webhook_secret"
TELEGRAM_ADMIN_CHAT_ID="op://smartout_ai/Telegram/admin_chat_id"

# LiveKit Cloud (Voice/Video)
LIVEKIT_API_KEY="op://smartout_ai/livekit/api-key"
LIVEKIT_API_SECRET="op://smartout_ai/livekit/api-secret"
NEXT_PUBLIC_LIVEKIT_URL="op://smartout_ai/livekit/wss-url"
LIVEKIT_WEBHOOK_SECRET="op://smartout_ai/livekit/webhook-secret"


# ── Contracts ───────────────────────────────────────────────────────────────
CONTRACT_SERVICE_KEY="op://smartout_ai/Contract-Service/api_key"
DOCUSEAL_API_KEY="op://smartout_ai/DocuSeal/api_key"
DOCUSEAL_API_URL=https://api.docuseal.com
DOCUSEAL_WEBHOOK_SECRET="op://smartout_ai/DocuSeal/webhook_secret"
SMARTOUT_COMPANY_NAME="Smartout AS"
SMARTOUT_ORG_NUMBER="op://smartout_ai/SmartOut/org_number"
SMARTOUT_CONTACT_EMAIL="op://smartout_ai/SmartOut/contact_email"
# Platform company details (contract autofill — same company, used in web app)
PLATFORM_COMPANY_NAME="Smartout AS"
PLATFORM_ORG_NUMBER="op://smartout_ai/SmartOut/org_number"
PLATFORM_CONTACT_EMAIL="op://smartout_ai/SmartOut/contact_email"
PLATFORM_CONTACT_NAME="op://smartout_ai/SmartOut/contact_name"


# ── Cache ───────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="op://smartout_ai/Upstash/rest_url"
UPSTASH_REDIS_REST_TOKEN="op://smartout_ai/Upstash/rest_token"


# ── Landing-only ────────────────────────────────────────────────────────────
SCRAPLING_AUTH_TOKEN="op://smartout_ai/Scrapling/SCRAPLING_AUTH_TOKEN"
STAGE_ENGINE_API_KEY="op://smartout_ai/Stage-Engine/api_key"
INTERVJU_MCP_WEBHOOK_SECRET="op://smartout_ai/Intervju-MCP/webhook_secret"
DEV_API_KEY="op://smartout_ai/Stage-Engine/api_key2"


# ── Supabase external auth (read by supabase/config.toml at runtime) ──────
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID="op://smartout_ai/Google-OAuth/client_id"
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET="op://smartout_ai/Google-OAuth/secret"


# ── CORS (Edge Functions) ──────────────────────────────────────────────────
ALLOWED_ORIGINS="http://localhost:3060,http://localhost:3055"

# ── Feature flags ──────────────────────────────────────────────────────────
NEXT_PUBLIC_FF_MY_CV=false
NEXT_PUBLIC_FF_SHIFT_CLOCK_LEADER=false
NEXT_PUBLIC_FF_AI_CHAT=false

N8N_ENCRYPTION_KEY="op://smartout_ai/n8n/encryption_key"
N8N_BASIC_AUTH_PASSWORD="op://smartout_ai/n8n/basic_auth_password"
N8N_BASIC_AUTH_USER="op://smartout_ai/n8n/basic_auth_user"