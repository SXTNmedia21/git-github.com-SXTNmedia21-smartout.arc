    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@smartout/eslint-config": "workspace:^",
    "@smartout/typescript-config": "workspace:*",
    "@types/node": "^20",
    "typescript": "^5.9.0",
    "vitest": "^4.0.18"
  }
