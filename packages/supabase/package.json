{
  "name": "@smartout/supabase",
  "version": "1.0.0",
  "description": "Supabase client and types for Smartout",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./middleware": {
      "types": "./src/middleware.ts",
      "default": "./src/middleware.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./admin": {
      "types": "./src/admin.ts",
      "default": "./src/admin.ts"
    },
    "./vault": {
      "types": "./src/vault.ts",
      "default": "./src/vault.ts"
    },
    "./database.types": {
      "types": "./src/database.types.ts",
      "default": "./src/database.types.ts"
    },
    "./service-config": {
      "types": "./src/service-config.ts",
      "default": "./src/service-config.ts"
    }
  },
  "scripts": {
    "build": "echo 'exports raw .ts — compiled by consuming app'",
    "lint": "eslint src/",
    "typecheck": "npx tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "2.49.4"
  },
  "devDependencies": {
    "@smartout/eslint-config": "workspace:^",
    "@smartout/typescript-config": "workspace:*",
    "@upstash/redis": "^1.36.3",
    "next": "^16.1.6",
    "typescript": "^5.0.0"
  }
}
