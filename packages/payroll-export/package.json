{
  "name": "@smartout/payroll-export",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npx tsc && node ../../scripts/fix-esm-imports.mjs",
    "dev": "npx tsc --watch",
    "lint": "eslint src/",
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@smartout/types": "workspace:*",
    "@smartout/utils": "workspace:*"
  },
  "devDependencies": {
    "@smartout/eslint-config": "workspace:^",
    "@smartout/typescript-config": "workspace:*",
    "@types/node": "^20",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.0",
    "vitest": "^4.0.18"
  }
}
