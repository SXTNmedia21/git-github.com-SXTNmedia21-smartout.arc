{
  "name": "@smartout/contracts",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./amendment-handler": {
      "types": "./dist/amendment-handler.d.ts",
      "default": "./dist/amendment-handler.js"
