{
  "name": "@smartout/ai",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./session-context": {
      "types": "./dist/session-context.d.ts",
      "default": "./dist/session-context.js"
    },
    "./tools/onboarding": {
      "types": "./dist/tools/onboarding.d.ts",
      "default": "./dist/tools/onboarding.js"
    },
    "./schemas/onboarding": {
      "types": "./dist/schemas/onboarding.d.ts",
      "default": "./dist/schemas/onboarding.js"
    },
    "./agents/onboarding": {
      "types": "./dist/agents/onboarding.d.ts",
      "default": "./dist/agents/onboarding.js"
    },
    "./agents/docs": {
      "types": "./dist/agents/docs.d.ts",
      "default": "./dist/agents/docs.js"
    },
    "./adapters/vercel-ai": {
      "types": "./dist/adapters/vercel-ai.d.ts",
      "default": "./dist/adapters/vercel-ai.js"
    },
    "./adapters/livekit": {
      "types": "./dist/adapters/livekit.d.ts",
      "default": "./dist/adapters/livekit.js"
    },
    "./missions": {
      "types": "./dist/missions/index.d.ts",
      "default": "./dist/missions/index.js"
    },
    "./tools/contract": {
      "types": "./dist/tools/contract/index.d.ts",
      "default": "./dist/tools/contract/index.js"
    },
    "./agents/contract": {
      "types": "./dist/agents/contract.d.ts",
      "default": "./dist/agents/contract.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^2.2.3",
    "@smartout/supabase": "workspace:*",
    "@supabase/supabase-js": "2.49.4",
    "ai": "^6.0.103",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@smartout/eslint-config": "workspace:^",
    "@smartout/typescript-config": "workspace:*",
    "typescript": "^5"
  }
}
