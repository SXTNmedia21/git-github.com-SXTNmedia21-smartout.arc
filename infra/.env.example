# ============================================================================
# infra/.env.example — Docker Compose Environment Variables
# ============================================================================
#
# Only variables referenced by docker-compose.yml.
# Copy to .env and fill in values:
#   cp .env.example .env
#
# ============================================================================


# ── Supabase (bootstrap) ────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stage Engine ────────────────────────────────────────────────────────────
ENGINE_URL=http://localhost:5010
ULTRAVOX_API_KEY=
OPENROUTER_API_KEY=
LOG_LEVEL=info
SESSION_EXPIRY_HOURS=24
CLEANUP_INTERVAL_MINUTES=5

# ── Contract Service ────────────────────────────────────────────────────────
CONTRACT_SERVICE_KEY=
DOCUSEAL_API_KEY=
DOCUSEAL_API_URL=https://api.docuseal.com
DOCUSEAL_WEBHOOK_SECRET=
SMARTOUT_COMPANY_NAME=Smartout AS
SMARTOUT_ORG_NUMBER=
SMARTOUT_CONTACT_EMAIL=pontus@smartout.io
APP_URL=https://app.smartout.ai

# ── n8n ─────────────────────────────────────────────────────────────────────
N8N_HOST=n8n.smartout.ai
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=https://n8n.smartout.ai/
GENERIC_TIMEZONE=Europe/Oslo
