{
  "name": "smartout.ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "op run --env-file=.env.template -- turbo run build",
    "dev": "op run --env-file=.env.template -- turbo run dev",
    "dev:local": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter e2e test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "build:health": "node scripts/quality/build-health-check.mjs",
    "perf:audit:web": "node scripts/perf/audit.mjs apps/web/perf-budgets.json",
    "perf:audit:landing": "node scripts/perf/audit.mjs apps/landing/perf-budgets.json",
    "perf:audit": "pnpm perf:audit:web && pnpm perf:audit:landing",
    "check": "turbo run lint typecheck",
    "clean": "turbo run clean && rimraf node_modules/.cache",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:gen-types": "npx supabase gen types typescript --local > packages/supabase/src/database.types.ts",
    "db:migrate:new": "npx supabase migration new",
    "api:docs:profile": "node scripts/api-docs/build-openapi-profile.mjs",
    "api:docs:internal": "node scripts/api-docs/build-openapi-profile.mjs --profile internal --output docs/reference/openapi.smartout.internal.yaml",
    "api:docs:partner": "node scripts/api-docs/build-openapi-profile.mjs --profile partner --output docs/reference/openapi.smartout.partner.yaml",
    "api:docs:public": "node scripts/api-docs/build-openapi-profile.mjs --profile public --output docs/reference/openapi.smartout.public.yaml",
    "api:docs:go-live": "node scripts/api-docs/build-openapi-profile.mjs --profile go-live --output docs/reference/openapi.smartout.go-live.yaml",
    "api:docs:verify-go-live": "node scripts/api-docs/build-openapi-profile.mjs --profile go-live --output docs/reference/openapi.smartout.go-live.yaml && git diff --exit-code -- docs/reference/openapi.smartout.go-live.yaml",
    "prepare": "husky"
  },
  "devDependencies": {
    "@remotion/google-fonts": "^4.0.428",
    "@remotion/lottie": "^4.0.428",
    "@remotion/shapes": "^4.0.428",
    "@remotion/tailwind": "^4.0.428",
    "@remotion/three": "^4.0.428",
    "@types/three": "^0.183.1",
    "autoprefixer": "10",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "lottie-web": "^5.13.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.13",
    "three": "^0.183.1",
    "turbo": "^2.8.11",
    "yaml": "^2.8.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "tailwind-merge": "^3.5.0"
  }
}
