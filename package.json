{
  "name": "smartout.ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "op run --env-file=.env.template -- turbo run build",
    "vercel-build": "turbo run build --filter=web",
    "dev": "op run --env-file=.env.template -- turbo run dev",
    "dev:local": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@remotion/google-fonts": "^4.0.428",
    "@remotion/lottie": "^4.0.428",
    "@remotion/shapes": "^4.0.428",
    "@remotion/tailwind": "^4.0.428",
    "@remotion/three": "^4.0.428",
    "@types/three": "^0.183.1",
    "autoprefixer": "10",
    "lottie-web": "^5.13.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.13",
    "three": "^0.183.1",
    "turbo": "^2.8.11"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "tailwind-merge": "^3.5.0"
  }
}
