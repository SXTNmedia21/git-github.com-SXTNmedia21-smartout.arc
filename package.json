{
  "name": "smartout.ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "command -v op >/dev/null 2>&1 && op run --env-file=.env.template -- turbo run build || turbo run build",
    "dev": "op run --env-file=.env.template -- turbo run dev",
    "dev:local": "turbo run dev",
    "dev:web": "op run --env-file=.env.template -- pnpm --filter web dev",
    "dev:landing": "op run --env-file=.env.template -- pnpm --filter landing dev",
    "dev:mobile": "op run --env-file=.env.template -- pnpm --filter mobile dev",
    "dev:journey-control": "pnpm --filter @smartout/journey-control dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter e2e test:e2e",
    "test:e2e:smoke": "pnpm --filter e2e test:e2e:smoke",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "build:health": "node scripts/quality/build-health-check.mjs",
    "perf:audit:web": "node scripts/perf/audit.mjs apps/web/perf-budgets.json",
    "perf:audit:landing": "node scripts/perf/audit.mjs apps/landing/perf-budgets.json",
    "perf:audit": "pnpm perf:audit:web && pnpm perf:audit:landing",
    "check": "turbo run lint typecheck",
    "ci:local": "bash scripts/ci-local.sh",
    "clean": "turbo run clean && rimraf node_modules/.cache",
    "db:start": "npx supabase start",
    "infra:start": "./infra/scripts/start.sh",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:gen-types": "npx supabase gen types typescript --local > packages/supabase/src/database.types.ts",
    "db:migrate:new": "npx supabase migration new",
    "page-knowledge:index": "tsx scripts/page-knowledge-index.ts",
    "api:docs:profile": "node scripts/api-docs/build-openapi-profile.mjs",
    "api:docs:internal": "node scripts/api-docs/build-openapi-profile.mjs --profile internal --output docs/reference/openapi.smartout.internal.yaml",
    "api:docs:partner": "node scripts/api-docs/build-openapi-profile.mjs --profile partner --output docs/reference/openapi.smartout.partner.yaml",
    "api:docs:public": "node scripts/api-docs/build-openapi-profile.mjs --profile public --output docs/reference/openapi.smartout.public.yaml",
    "api:docs:go-live": "node scripts/api-docs/build-openapi-profile.mjs --profile go-live --output docs/reference/openapi.smartout.go-live.yaml",
    "api:docs:verify-go-live": "node scripts/api-docs/build-openapi-profile.mjs --profile go-live --output docs/reference/openapi.smartout.go-live.yaml && git diff --exit-code -- docs/reference/openapi.smartout.go-live.yaml",
    "docs:ingest": "pnpm --filter @smartout/docs-pipeline ingest",
    "docs:ingest:force": "pnpm --filter @smartout/docs-pipeline ingest:force",
    "docs:ingest:dry-run": "pnpm --filter @smartout/docs-pipeline ingest:dry-run",
    "docs:validate": "pnpm --filter @smartout/docs-pipeline validate",
    "docs:validate:strict": "pnpm --filter @smartout/docs-pipeline validate:strict",
    "docs:watch": "pnpm --filter @smartout/docs-pipeline watch",
    "docs:ingest:git": "pnpm --filter @smartout/docs-pipeline ingest -- --mode git",
    "docs:ingest:git:main": "pnpm --filter @smartout/docs-pipeline ingest -- --mode git --git-ref origin/main",
    "authority-seed-parity": "tsx scripts/authority-seed-parity.ts",
    "cascade-gate-entity-type-coverage": "tsx scripts/cascade-gate-entity-type-coverage.ts",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "typescript": "^5.9.0",
    "@remotion/google-fonts": "^4.0.428",
    "@remotion/lottie": "^4.0.428",
    "@remotion/shapes": "^4.0.428",
    "@remotion/tailwind": "^4.0.428",
    "@remotion/three": "^4.0.428",
    "@types/three": "^0.183.1",
    "autoprefixer": "10",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "lottie-web": "^5.13.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.13",
    "three": "^0.183.1",
    "ts-morph": "^24.0.0",
    "tsx": "^4.19.4",
    "turbo": "^2.8.11",
    "yaml": "^2.8.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "@tanstack/react-query": "5.99.0"
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "tailwind-merge": "^3.5.0"
  }
}
