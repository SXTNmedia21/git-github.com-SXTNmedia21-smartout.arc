{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash apps/web/scripts/preflight-json.sh 2>/dev/null || echo '{\"ok\":1,\"errors\":[{\"type\":\"script\",\"issue\":\"preflight script failed\"}],\"warnings\":[]}'",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/skill-trigger-reminder.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/typecheck.sh\"",
            "asyncRewake": true,
            "timeout": 180,
            "statusMessage": "typecheck (turbo-cached)"
          }
        ]
      }
    ]
  }
}
