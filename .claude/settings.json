{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash apps/web/scripts/preflight-json.sh 2>/dev/null || echo '{\"ok\":1,\"errors\":[{\"type\":\"script\",\"issue\":\"preflight script failed\"}],\"warnings\":[]}'",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/sxtnl/dev/smartout.ai/.claude/hooks/skill-trigger-reminder.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/sxtnl/dev/smartout.ai/.claude/metadata-updater.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/sxtnl/dev/smartout.ai/.claude/hooks/typecheck.sh",
            "asyncRewake": true,
            "timeout": 180,
            "statusMessage": "typecheck (turbo-cached)"
          }
        ]
      }
    ]
  }
}
